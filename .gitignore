```gitignore
# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Database files
*.db
*.sqlite
*.sqlite3

# Django
*.log
db.sqlite3
db.sqlite3-journal

# Environment variables / secrets
.env
.env.*

# Static files collected for deployment
staticfiles/

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Python packaging
*.egg-info/
dist/
build/

# macOS
.DS_Store
# Generated semantic index
*.bin

# Virtual environment
.venv/

# Local editor cache
.cph/

# Coverage
.coverage
htmlcov/
.pytest_cache/
```